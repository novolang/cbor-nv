// tests/embedded_probe.nv — the package's device claim, as a program
// that either builds for a Cortex-M or does not.
//
// The shard audit's `core-embedded` row copies this and the modules its
// `use` lines reach into a package of its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.  For this package the
// claim is what the grid's row claims on its behalf — that the embedded
// tier prefers CBOR — and a claim that was only asserted would not be
// worth the sentence.
//
// It BUILDS; it does not run.  Every function it calls is a `todo()`
// today, so a device that executed this would panic on the first line
// of `main`.  What is being checked is the tier: `--target=nrf52-qemu`
// stamps `@tier(embedded)` on every function it compiles, so the
// checker walks the module and refuses a `Str` concatenation, a `Bytes`
// call or an unbounded `while` wherever the implementation later puts
// one.
//
// ONLY `cborhead` IS USED HERE, and that is the split rather than a
// convenience: `cborfmt`, `cbordec` and `cborserde` speak `Bytes`,
// `Str` and a recursive value tree, the embedded runtime defines no
// `novo_bytes_*` symbol and a tree is a heap allocation per node, and
// one host-only function anywhere in a compilation unit is an undefined
// symbol at embedded link time whether or not the firmware calls it.
//
// WHAT THE PROBE PROVES a device can do: write a map head and an
// integer head per reading, and walk a document's heads back.  That is
// what a sensor producing CBOR does, and it never builds a tree at all.

use cborhead

// Four bytes of a document, the way firmware would hold them.
//
// The array is a FIELD of a `@value` struct rather than a return type,
// because `[u8; 4]` is a true inline array only inside one — outside,
// the annotation still means a list, and a list literal is an implicit
// heap allocation the tier refuses (SPEC § 14.4).
@value
struct ProbeDoc
    b: [u8; 4]

// `a2 01 02 03` — a map head of two pairs, then three small integers.
// The first byte is a head with its argument inside it; the rest are
// one-byte heads of their own.
fn probe_doc() -> ProbeDoc
    ProbeDoc { b: [0xA2 as u8, 0x01 as u8, 0x02 as u8, 0x03 as u8] }

fn main() [hw]
    // The major types, so the arithmetic that reads them is compiled
    // for the device and not only for the host.
    let uns = cborhead.major_unsigned()
    let neg = cborhead.major_negative()
    let bin = cborhead.major_bytes()
    let txt = cborhead.major_text()
    let arr = cborhead.major_array()
    let map = cborhead.major_map()
    let tag = cborhead.major_tag()
    let simple = cborhead.major_simple()
    let stop = cborhead.break_byte()

    // The sizing a producer does before it writes: how long the head
    // will be, and what its first byte is.
    let small = cborhead.head_len(23)
    let wide = cborhead.head_len(1000)
    let first = cborhead.initial_byte(uns, 1)

    // The negative fold, which is the one piece of CBOR arithmetic that
    // is not a shift.
    let folded = cborhead.negative_arg(0 - 1)
    let unfolded = cborhead.negative_value(folded)

    // A producer: an array head, then a head per reading.  This is the
    // whole of what firmware writes, and it allocates nothing.
    //
    // Each step is bound with its type written out because a call into
    // another module does not have its return type inferred in a
    // single-file build.  Inside a package built as one unit — which is
    // what every host suite does — none of these annotations is needed.
    let opened: CborEmit = cborhead.emit_indefinite(arr)
    for k in 0..opened.len
        // A real transport would put this byte in a queue; here the
        // read is what forces the array access to be compiled.
        let b: u8 = opened.out[k]
        hal.uart.write("[")

    for i in 0..4
        let head: CborEmit = cborhead.emit_head(uns, i)
        if head.ok
            for k in 0..head.len
                let b: u8 = head.out[k]
                hal.uart.write(".")

    let closed: CborEmit = cborhead.emit_break()
    for k in 0..closed.len
        let b: u8 = closed.out[k]
        hal.uart.write("]")

    // A consumer: heads walked a byte at a time, which is the shape a
    // device reading from a UART has.
    let src = probe_doc()
    var s: CborHeadScan = cborhead.scan()
    for i in 0..4
        if not s.done
            s = cborhead.push(s, src.b[i])
    let more = cborhead.scan_need(s)
    if s.done and not s.bad
        hal.uart.write("!")

    hal.uart.write("cbor-nv: heads in, heads out\n")
